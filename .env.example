# ===============================================
# PanSou 网盘搜索机器人配置
# ===============================================

# 1. Telegram Bot Token (必填)
# 在 Telegram 搜索并打开 @BotFather，发送 /newbot 创建机器人并获取 Token
BOT_TOKEN=

# 2. 网络代理设置 (如果在国内大陆环境运行，必须配置此项才能访问 Telegram)
# - 本地直接运行: PROXY=http://127.0.0.1:7890
# - Docker 容器内运行: PROXY=http://host.docker.internal:7890 (或写你主机的局域网 IP)
PROXY=

# 3. 监控的公开 Telegram 频道列表 (英文逗号分隔，无需带 @)
# 推荐高频发布的网盘资源频道：
CHANNELS=yunpanpan,ucpanpan,yppshare,hao1234cn,Quark_Share_Group,alyp_4K_remux,shareAliyun

# 4. 爬虫抓取设置
# 每个频道每次回溯抓取多少页历史消息 (每页约 20 条消息)
CRAWL_PAGES_PER_CHANNEL=3

# 后台自动轮询抓取的周期 (单位: 分钟)
CRAWL_INTERVAL_MINUTES=60

# 5. 管理员 Telegram User ID (选填，逗号分隔)
# 用于权限控制，如只允许管理员在 Bot 内执行 /crawl
# ADMIN_USER_IDS=123456789,987654321
ADMIN_USER_IDS=

# 6. 数据库路径 (默认放在当前目录的 pansou.db)
DB_PATH=pansou.db
